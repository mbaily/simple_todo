# The backend always serves plain HTTP; Caddy handles public HTTPS.
SIMPLE_TODO_HOST=127.0.0.1
SIMPLE_TODO_PORT=3102

# Public prefix stripped by Caddy. Use an empty value for a root installation.
SIMPLE_TODO_ROOT_PATH=/simple_todo

# Uvicorn trusts forwarded headers from a local Caddy instance by default.
# If Caddy runs elsewhere, set FORWARDED_ALLOW_IPS to its IP address.

# Optional authentication:
# SIMPLE_TODO_BASIC_AUTH=1
# SIMPLE_TODO_HTPASSWD_PATH=.htpasswd
# SIMPLE_TODO_SESSION_SECRET=generate-a-long-random-secret

# Export SIMPLE_TODO_DATA_DIR=/var/lib/simple_todo before starting the app.
# With an external directory, put this .env there and load it via systemd's
# EnvironmentFile or run_dev.sh. Direct Python/uvicorn launches use exported
# variables; they do not automatically load .env files.
# Databases, .htpasswd, session-secret, settings.json and editable smart-folder
# defaults then live there. SIMPLE_TODO_DB_PATH is ignored in this mode so
# each user gets a separate database. See docs/STORAGE.md for migration.

# Optional read-only bills integration key (store only its SHA-256 digest here):
# SIMPLE_TODO_BILLS_API_USER=your-simple-todo-username
# SIMPLE_TODO_BILLS_API_KEY_SHA256=64-hex-character-sha256-digest
